        <script><![CDATA[function onLoad() {
    applyMode(g_form.getValue('mode'));

    function applyMode(mode) {
        var caseVars = ['source_case', 'target_case'];
        var userVars = ['source_user', 'target_user'];
        var i;
        for (i = 0; i < caseVars.length; i++) g_form.setDisplay(caseVars[i], mode === 'case');
        for (i = 0; i < userVars.length; i++) g_form.setDisplay(userVars[i], mode === 'user');
        g_form.setMandatory('source_case', mode === 'case');
        g_form.setMandatory('target_case', mode === 'case');
        g_form.setMandatory('target_user', mode === 'user');
    }
}]]></script>
